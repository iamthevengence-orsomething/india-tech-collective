---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FileSection from '../components/FileSection.astro';
import ShareRow from '../components/islands/ShareRow.tsx';
import { CATS, TOOLS } from '../data/tools';
import { slugify } from '../lib/slug';

const scenarioByCategory: Record<string, string[]> = {
  mesh: ['offline', 'slow'],
  messaging: ['watched', 'slow'],
  circum: ['slow', 'watched'],
  evidence: ['offline', 'watched'],
  monitor: ['slow'],
  organize: ['slow'],
  whistle: ['watched'],
};
const repoIssues = 'https://github.com/iamthevengence-orsomething/india-tech-collective/issues/new';
---

<Base
  title="The Kit — open-source tools for difficult networks | India Tech Collective"
  description="Twenty-seven open-source tools for offline messaging, secure channels, circumvention, evidence preservation, monitoring, organizing, and whistleblowing."
  path="/toolkit/"
  current="toolkit"
  ogImage="/og/toolkit.png"
>
  <PageHeader
    file="ITC/KIT/027"
    eyebrow="Tools / difficult networks"
    title="State your situation."
    lede="Twenty-seven open-source tools, organized by what the network is doing—not by product category alone."
    status="27 source links attached"
  >
    <div class="kit-warning">
      <span class="stamp">Source attached</span>
      <p>Chosen is not endorsed. Security changes; inspect current project guidance before trusting a tool with sensitive work.</p>
    </div>
  </PageHeader>

  <section class="scenario-panel wrap-wide" aria-labelledby="scenario-title">
    <div>
      <p class="file-label">Fast path / filter</p>
      <h2 id="scenario-title">What is the network doing?</h2>
    </div>
    <div class="scenario-buttons" id="scenarioFilters" role="group" aria-label="Filter tools by situation">
      <button type="button" data-scenario="offline" aria-pressed="false"><span>01</span><strong>No internet</strong><small>mesh + local evidence</small></button>
      <button type="button" data-scenario="slow" aria-pressed="false"><span>02</span><strong>Slow / throttled</strong><small>reach + measure</small></button>
      <button type="button" data-scenario="watched" aria-pressed="false"><span>03</span><strong>Watched</strong><small>protect + minimize</small></button>
      <button type="button" data-scenario="all" aria-pressed="true"><span>00</span><strong>Show all</strong><small>full catalog</small></button>
    </div>
    <p id="scenarioResult" class="scenario-result" aria-live="polite">Showing all {TOOLS.length} tools.</p>
  </section>

  <FileSection
    index="01"
    eyebrow="The catalog"
    title="Every tool keeps its limits visible."
    description="Full catalog renders in HTML. The situation picker only narrows it."
    wide={true}
  >
    <div class="tool-grid" id="toolGrid">
      {TOOLS.map((tool, index) => (
        <article
          class="tool-file"
          data-category={tool.cat}
          data-scenarios={scenarioByCategory[tool.cat].join(' ')}
        >
          <div class="tool-file__top">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <i>{CATS[tool.cat].label}</i>
          </div>
          <h3><a href={`/tools/${slugify(tool.name)}/`}>{tool.name} →</a></h3>
          <p class="tool-file__desc">{tool.desc}</p>
          <div class="tool-file__proof">
            <span>{tool.proofKind === 'why' ? 'WHEN IT MATTERS' : 'FIELD NOTE'}</span>
            <p>{tool.proof}</p>
          </div>
          <div class:list={['tool-file__limit', { 'tool-file__limit--gap': !tool.caveat }]}>
            <span>LIMITS</span>
            <p>{tool.caveat ?? 'No project-specific limit has been added to this catalog entry yet. Check the source documentation.'}</p>
          </div>
          <a class="source-stamp" href={tool.url} rel="noopener">SOURCE ATTACHED</a>
        </article>
      ))}
    </div>
  </FileSection>

  <FileSection
    index="02"
    eyebrow="Take the file"
    title="Portable by default."
    description="The repository and data packages can be copied now. A verified APK/ZIM bundle is not yet published."
  >
    <div class="kit-box">
      <div>
        <p class="file-label">Release package</p>
        <h3>Take the records. Keep the source.</h3>
        <p>Download the published datasets or clone the repository. Offline application bundles remain a visible distribution gap.</p>
      </div>
      <div class="kit-box__actions">
        <a class="btn btn-primary" href="/downloads/README.txt">Open download register</a>
        <a class="btn" href="/mirrors/">Inspect mirrors</a>
        <span class="stamp red">ZIM / APK bundle pending</span>
      </div>
    </div>
  </FileSection>

  <FileSection
    index="03"
    eyebrow="Practice"
    title="Tools are half the answer."
    description="Start with a threat model. Keep project documentation close."
  >
    <div class="drawer-grid">
      <a class="drawer" href="https://securityinabox.org" rel="noopener"><span class="drawer__no">A</span><p class="file-label">Guide</p><h3>Security-in-a-Box</h3><p>Device security, safer communication, and account protection.</p><small>open guide ↗</small></a>
      <a class="drawer" href="https://ssd.eff.org" rel="noopener"><span class="drawer__no">B</span><p class="file-label">Guide</p><h3>Surveillance Self-Defense</h3><p>Threat modelling before product selection.</p><small>open guide ↗</small></a>
      <a class="drawer" href="https://secfirst.org" rel="noopener"><span class="drawer__no">C</span><p class="file-label">Guide</p><h3>Umbrella</h3><p>Digital and physical safety lessons for difficult contexts.</p><small>open guide ↗</small></a>
    </div>
  </FileSection>

  <FileSection
    index="04"
    eyebrow="Corrections / additions"
    title="Know a better tool?"
    description="Open one issue with the source, the use case, and the limitation we should state."
  >
    <div class="share-row">
      <a class="btn btn-primary" href={`${repoIssues}?title=${encodeURIComponent('Toolkit proposal: [tool name]')}`} rel="noopener">Propose a tool ↗</a>
      <a class="btn" href={`${repoIssues}?title=${encodeURIComponent('Toolkit correction: [tool name]')}`} rel="noopener">Correct an entry ↗</a>
    </div>
      <ShareRow
        client:visible
        cardHref="/og/toolkit.png"
      spec={{
        headline: 'The India Tech Collective — tools for difficult networks',
        definition: 'Twenty-seven open-source tools for offline communication, secure channels, circumvention, evidence, monitoring, and public-interest work.',
        asOf: '2026',
        source: 'official project links',
        url: 'https://www.indiatechcollective.org/toolkit/',
        disclaimer: 'Chosen is not endorsed. Read current project guidance before sensitive use.',
      }}
    />
  </FileSection>
</Base>

<script is:inline>
  (function () {
    var controls = Array.from(document.querySelectorAll('#scenarioFilters button'));
    var tools = Array.from(document.querySelectorAll('#toolGrid .tool-file'));
    var result = document.getElementById('scenarioResult');
    controls.forEach(function (control) {
      control.addEventListener('click', function () {
        var scenario = control.getAttribute('data-scenario') || 'all';
        var visible = 0;
        controls.forEach(function (item) { item.setAttribute('aria-pressed', item === control ? 'true' : 'false'); });
        tools.forEach(function (tool) {
          var match = scenario === 'all' || (tool.getAttribute('data-scenarios') || '').split(' ').includes(scenario);
          tool.hidden = !match;
          if (match) visible += 1;
        });
        if (result) result.textContent = 'Showing ' + visible + ' tools for ' + control.querySelector('strong').textContent.toLowerCase() + '.';
      });
    });
  })();
</script>

<style>
  .kit-warning { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.2rem; }
  .kit-warning p { max-width: 58ch; color: var(--muted); font-size: .9rem; }
  .scenario-panel {
    display: grid;
    grid-template-columns: minmax(220px, .45fr) 1.55fr;
    gap: 2rem;
    padding-block: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--line-strong);
  }
  .scenario-panel h2 { margin-top: .7rem; font-size: clamp(2rem, 4vw, 3.4rem); line-height: .95; }
  .scenario-buttons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; border: 1px solid var(--line-strong); background: var(--line-strong); }
  .scenario-buttons button {
    min-height: 150px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1rem;
    background: var(--surface);
    text-align: left;
  }
  .scenario-buttons button:hover { background: var(--paper-2); }
  .scenario-buttons button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .scenario-buttons span { font-family: var(--mono); color: var(--seal-red); }
  .scenario-buttons button[aria-pressed="true"] span { color: var(--phosphor); }
  .scenario-buttons strong { margin-top: 2rem; font-family: var(--mono); font-size: .72rem; text-transform: uppercase; }
  .scenario-buttons small { margin-top: auto; color: var(--muted); font-size: .72rem; }
  .scenario-buttons button[aria-pressed="true"] small { color: color-mix(in srgb, var(--paper) 62%, transparent); }
  .scenario-result { grid-column: 2; font-family: var(--mono); font-size: .62rem; color: var(--muted); }
  .tool-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .tool-file {
    position: relative;
    min-height: 430px;
    display: flex;
    flex-direction: column;
    padding: 1.2rem 1.2rem 1.15rem 2rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: var(--shadow-file);
  }
  .tool-file::before { content: ""; position: absolute; inset: 0 auto 0 1rem; width: 2px; background: var(--seal-red); opacity: .55; }
  .tool-file[hidden] { display: none; }
  .tool-file__top { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: .65rem; border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: .56rem; }
  .tool-file__top span { color: var(--seal-red); }
  .tool-file__top i { color: var(--muted); font-style: normal; text-transform: uppercase; }
  .tool-file h3 { margin-top: 1.4rem; font-size: 1.8rem; }
  .tool-file h3 a { color: inherit; text-decoration: none; }
  .tool-file h3 a:hover { color: var(--stamp-violet); }
  .tool-file__desc { margin-top: .7rem; color: var(--ink); }
  .tool-file__proof, .tool-file__limit { margin-top: 1rem; padding-top: .75rem; border-top: 1px dotted var(--line-strong); }
  .tool-file__proof span, .tool-file__limit span { font-family: var(--mono); font-size: .52rem; letter-spacing: .1em; color: var(--stamp-violet); }
  .tool-file__proof p, .tool-file__limit p { margin-top: .35rem; color: var(--muted); font-size: .86rem; }
  .tool-file__limit span { color: var(--alert); }
  .tool-file__limit--gap p { color: var(--faint); }
  .source-stamp { width: fit-content; margin-top: auto; padding: .3rem .55rem; border: 2px solid var(--stamp-violet); color: var(--stamp-violet); font-family: var(--mono); font-size: .52rem; font-weight: 700; letter-spacing: .1em; text-decoration: none; transform: rotate(-1deg); }
  .kit-box { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; padding: clamp(1.4rem, 4vw, 3rem); border: 1px solid var(--line-strong); background: color-mix(in srgb, var(--file-khaki) 16%, var(--surface)); box-shadow: var(--shadow-file); }
  .kit-box h3 { margin-top: .7rem; font-size: clamp(2rem, 4vw, 3.5rem); }
  .kit-box p:not(.file-label) { max-width: 54ch; margin-top: .8rem; color: var(--muted); }
  .kit-box__actions { display: grid; gap: .8rem; min-width: 260px; }
  @media (max-width: 1000px) {
    .scenario-panel { grid-template-columns: 1fr; }
    .scenario-result { grid-column: 1; }
    .tool-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .scenario-buttons { grid-template-columns: repeat(2, 1fr); }
    .tool-grid { grid-template-columns: 1fr; }
    .tool-file { min-height: 390px; }
    .kit-box { grid-template-columns: 1fr; }
  }
  @media (max-width: 440px) { .scenario-buttons { grid-template-columns: 1fr; } }
</style>
