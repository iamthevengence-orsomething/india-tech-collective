---
import Base from '../layouts/Base.astro';
const needs = [
  ['Data', 'Verify constituency and affidavit records.'],
  ['Design', 'Refine stamps, print layouts, and small-screen states.'],
  ['Engineering', 'Improve offline delivery, search, and accessibility.'],
  ['Language', 'Translate field guidance without losing precision.'],
  ['Research', 'Trace every claim to its primary record.'],
];
---
<Base
  title="Contribute — India Tech Collective"
  description="Contribute code, verification, translation, design, or documentation to the public civic-tech record."
  path="/contribute/"
  current="contribute"
>
  <header class="rolls-head wrap-wide">
    <div>
      <p class="file-label">The rolls / contributors</p>
      <h1>We take commits.</h1>
      <p>Small, reviewable work is welcome. The issue tracker is the front door.</p>
    </div>
    <a class="repo-ticket" href="https://github.com/iamthevengence-orsomething/india-tech-collective" rel="noopener">
      <span>Repository</span>
      <strong>india-tech-collective</strong>
      <small>Open on GitHub ↗</small>
    </a>
  </header>

  <section class="needs wrap-wide" aria-labelledby="needs-title">
    <p class="file-label">What the file needs now</p>
    <h2 id="needs-title">Choose a lane.</h2>
    <div class="need-grid">
      {needs.map(([name, copy], index) => (
        <a class="need-card" href="https://github.com/iamthevengence-orsomething/india-tech-collective/issues" rel="noopener">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{name}</h3>
          <p>{copy}</p>
          <small>View issues ↗</small>
        </a>
      ))}
    </div>
  </section>

  <section class="risk wrap">
    <p class="file-label">Contributor safety</p>
    <h2>Use the name that keeps you safe.</h2>
    <div>
      <article>
        <h3>Public</h3>
        <p>Contribute through your usual GitHub identity.</p>
      </article>
      <article>
        <h3>Pseudonymous</h3>
        <p>Use a separate account and remove personal metadata from commits.</p>
      </article>
      <article>
        <h3>No code</h3>
        <p>Report a correction, check a source, or improve documentation.</p>
      </article>
    </div>
  </section>
</Base>

<style>
  .rolls-head { display: grid; grid-template-columns: 1fr minmax(280px, 0.45fr); gap: 3rem; align-items: end; padding-block: clamp(4rem, 10vw, 9rem); }
  .rolls-head h1 { margin-top: 1rem; font-size: clamp(4rem, 10vw, 8rem); letter-spacing: -0.06em; line-height: 0.82; }
  .rolls-head > div > p:last-child { margin-top: 1.5rem; color: var(--muted); font-size: 1.2rem; }
  .repo-ticket { display: grid; padding: 1.4rem; border: 1px solid var(--line-strong); background: var(--paper-2); color: inherit; text-decoration: none; box-shadow: 6px 6px 0 rgba(75, 58, 143, 0.12); }
  .repo-ticket span, .repo-ticket small { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .repo-ticket strong { margin-block: 1.8rem; overflow-wrap: anywhere; font-family: var(--mono); font-size: 1.05rem; color: var(--stamp-violet); }
  .needs { padding-block: 1rem 6rem; }
  .needs h2, .risk h2 { margin-top: 0.6rem; font-size: clamp(2.2rem, 5vw, 4rem); }
  .need-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; margin-top: 2rem; background: var(--line-strong); border: 1px solid var(--line-strong); }
  .need-card { min-height: 300px; display: flex; flex-direction: column; padding: 1.2rem; background: var(--surface); color: inherit; text-decoration: none; transition: background 120ms, color 120ms; }
  .need-card:hover { background: var(--stamp-violet-dark); color: #f4edde; }
  .need-card > span { font-family: var(--mono); color: var(--seal-red); }
  .need-card h3 { margin-top: 3rem; font-size: 1.6rem; color: inherit; }
  .need-card p { margin-top: 0.8rem; color: var(--muted); }
  .need-card:hover p { color: rgba(244, 237, 222, 0.75); }
  .need-card small { margin-top: auto; font-family: var(--mono); font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .risk { padding-block: 5rem 8rem; border-top: 1px solid var(--line-strong); }
  .risk > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
  .risk article { border-top: 2px solid var(--stamp-violet); padding-top: 1rem; }
  .risk h3 { font-size: 1.5rem; }
  .risk article p { margin-top: 0.65rem; color: var(--muted); }
  @media (max-width: 960px) { .need-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 680px) {
    .rolls-head { grid-template-columns: 1fr; }
    .need-grid, .risk > div { grid-template-columns: 1fr; }
    .need-card { min-height: 220px; }
  }
</style>
