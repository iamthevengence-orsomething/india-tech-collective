---
import Base from '../layouts/Base.astro';
const tallies = Array.from({ length: 65 }, (_, index) => index + 1);
const nodes = [
  [12, 48], [20, 24], [28, 62], [34, 16], [40, 44], [47, 72],
  [53, 30], [60, 55], [67, 12], [73, 38], [80, 67], [88, 26],
  [18, 78], [31, 86], [55, 88], [72, 82], [86, 52], [44, 8],
];
---

<Base
  title="The Signals — India Tech Collective"
  description="A sourced view of internet shutdowns in India, with methodology and disagreement kept visible."
  path="/signals/"
  current="signals"
>
  <div class="signals-shell">
    <header class="signal-hero wrap-wide">
      <div class="signal-rail" aria-hidden="true">ITC / SIGNALS / 2025</div>
      <div class="signal-copy">
        <div class="signal-meta"><span>network status / public log</span><i>tracker online</i></div>
        <h1>The signal can stop.<br /><em>The record cannot.</em></h1>
        <p>
          Connectivity disappears quietly. This file keeps the count, the method,
          and the disagreement between trackers visible.
        </p>
        <div class="signal-command" aria-label="Signal system principle">
          <span>observe</span><code>network → interruption → source</code>
        </div>
      </div>
      <div class="node-field" aria-hidden="true">
        {nodes.map(([x, y]) => <i style={`--x:${x}%;--y:${y}%`}></i>)}
      </div>
    </header>

    <section class="tally-section wrap-wide" aria-labelledby="tally-title">
      <div class="tally-copy">
        <p class="signal-kicker">India · calendar year 2025</p>
        <h2 id="tally-title"><strong>65</strong> recorded shutdowns.</h2>
        <p>
          Access Now and the #KeepItOn coalition recorded 65 shutdowns in India in
          2025. Each mark below is one recorded interruption, not an abstraction.
        </p>
        <a href="https://www.accessnow.org/internet-shutdowns-2025/" rel="noopener">Open the source report ↗</a>
      </div>
      <div class="tally-wall" aria-label="Sixty-five tally marks, one for each recorded shutdown in 2025">
        {tallies.map((tally) => <i style={`--i:${tally}`} aria-hidden="true"></i>)}
      </div>
    </section>

    <section class="signal-gap wrap-wide" aria-labelledby="event-log-title">
      <div>
        <p class="signal-kicker">Event-level file</p>
        <h2 id="event-log-title">The districts are not in this release.</h2>
        <p>
          District dates, stated justifications, and affected-population denominators
          have not passed this repository’s publication checks.
        </p>
      </div>
      <span>GAP IN RECORD</span>
    </section>

    <section class="signal-method wrap-wide" aria-label="Signal methodology">
      <article>
        <span>01</span>
        <h2>What counts.</h2>
        <p>
          A deliberate disruption of internet or electronic communications that makes
          access unavailable or effectively unusable for a population or location.
        </p>
      </article>
      <article>
        <span>02</span>
        <h2>Whose count.</h2>
        <p>
          Access Now publishes an annual global dataset. SFLC.in maintains a separate
          India tracker. Methods and verification windows can differ.
        </p>
      </article>
      <article>
        <span>03</span>
        <h2>What stays separate.</h2>
        <p>
          The file does not force rival counts into one false total. Each source keeps
          its own definition, date, and denominator.
        </p>
      </article>
    </section>

    <footer class="signal-sources wrap-wide">
      <p>sources / dated</p>
      <a href="https://www.accessnow.org/internet-shutdowns-2025/" rel="noopener">
        Access Now · 2025 annual report · published 31 Mar 2026
      </a>
      <a href="https://sflc.in/access/" rel="noopener">SFLC.in Internet Shutdowns Tracker</a>
      <a href="/methodology/">Read the project methodology →</a>
    </footer>
  </div>
</Base>

<style>
  .signals-shell {
    --signal: #56f47b;
    --signal-dim: rgba(86, 244, 123, .64);
    min-height: 100vh;
    padding-bottom: 5rem;
    color: #d8ffe0;
    background:
      repeating-linear-gradient(0deg, rgba(86,244,123,.025) 0 1px, transparent 1px 4px),
      radial-gradient(circle at 82% 8%, rgba(86,244,123,.1), transparent 28%),
      #090b09;
    font-family: var(--mono);
  }
  .signal-hero {
    min-height: min(760px, calc(100vh - 66px));
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) minmax(280px, .65fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(4rem, 9vw, 8rem);
    border-bottom: 1px solid rgba(86,244,123,.35);
  }
  .signal-rail {
    align-self: stretch;
    padding-top: 1rem;
    border-right: 1px solid rgba(86,244,123,.3);
    color: var(--signal-dim);
    font-size: .52rem;
    letter-spacing: .12em;
    writing-mode: vertical-rl;
  }
  .signal-meta {
    max-width: 760px;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .65rem;
    border-bottom: 1px solid rgba(86,244,123,.28);
    color: var(--signal-dim);
    font-size: .58rem;
    letter-spacing: .11em;
    text-transform: lowercase;
  }
  .signal-meta i { color: var(--signal); font-style: normal; }
  .signal-meta i::before { content: "● "; }
  .signal-copy h1 {
    max-width: 12ch;
    margin-top: 1.5rem;
    color: #effff2;
    font-family: var(--mono);
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 400;
    letter-spacing: -.07em;
    line-height: .88;
  }
  .signal-copy h1 em { color: var(--signal); font-style: normal; }
  .signal-copy > p {
    max-width: 52ch;
    margin-top: 1.5rem;
    color: rgba(216,255,224,.7);
    font-family: var(--body);
  }
  .signal-command {
    width: fit-content;
    display: flex;
    gap: .8rem;
    margin-top: 1.5rem;
    padding: .6rem .8rem;
    border: 1px solid rgba(86,244,123,.35);
    color: rgba(216,255,224,.56);
    font-size: .62rem;
  }
  .signal-command code { color: var(--signal); }
  .node-field { position: relative; min-height: 420px; }
  .node-field::before,
  .node-field::after {
    content: "";
    position: absolute;
    inset: 14% 12%;
    border: 1px solid rgba(86,244,123,.18);
    border-radius: 50%;
  }
  .node-field::after { inset: 27%; }
  .node-field i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 14px var(--signal);
  }
  .node-field i:nth-child(5n) { opacity: .12; box-shadow: none; }
  .tally-section {
    display: grid;
    grid-template-columns: minmax(280px, .7fr) 1.3fr;
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid rgba(86,244,123,.25);
  }
  .signal-kicker { color: var(--signal-dim); font-size: .62rem; letter-spacing: .13em; text-transform: lowercase; }
  .tally-copy h2 {
    margin-top: 1rem;
    color: #effff2;
    font-family: var(--mono);
    font-size: clamp(2rem, 5vw, 4.2rem);
    font-weight: 400;
    line-height: 1.05;
  }
  .tally-copy h2 strong { display: block; color: var(--signal); font-size: 2.2em; line-height: .8; }
  .tally-copy > p:not(.signal-kicker) { max-width: 42ch; margin-top: 1.5rem; color: rgba(216,255,224,.68); font-family: var(--body); }
  .tally-copy a { display: inline-block; margin-top: 1.4rem; color: var(--signal); font-size: .68rem; text-underline-offset: 4px; }
  .tally-wall { display: grid; grid-template-columns: repeat(13, 1fr); gap: clamp(.7rem, 2vw, 1.4rem); align-content: center; }
  .tally-wall i {
    display: block;
    height: clamp(38px, 6vw, 68px);
    border-left: 3px solid var(--signal);
    transform: rotate(calc((var(--i) - 33) * .035deg));
    opacity: calc(.55 + (var(--i) * .006));
  }
  .tally-wall i:nth-child(5n) { transform: rotate(17deg) translateX(-14px); transform-origin: bottom; }
  .signal-gap {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: center;
    margin-top: 4rem;
    padding-block: 1.5rem;
    border-block: 1px dashed rgba(86,244,123,.35);
  }
  .signal-gap h2 { margin-top: .7rem; color: #effff2; font-family: var(--mono); font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 400; }
  .signal-gap p:not(.signal-kicker) { max-width: 62ch; margin-top: .7rem; color: rgba(216,255,224,.6); font-family: var(--body); }
  .signal-gap > span { flex: none; padding: .55rem .7rem; border: 2px solid var(--signal); color: var(--signal); font-size: .58rem; letter-spacing: .12em; transform: rotate(-2deg); }
  .signal-method {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 4rem;
    border: 1px solid rgba(86,244,123,.25);
    background: rgba(86,244,123,.25);
  }
  .signal-method article { min-height: 280px; padding: 1.5rem; background: #0d120e; }
  .signal-method article > span { color: var(--signal); font-size: .68rem; }
  .signal-method h2 { margin-top: 2.5rem; color: #effff2; font-family: var(--mono); font-size: 1.25rem; font-weight: 400; }
  .signal-method p { margin-top: 1rem; color: rgba(216,255,224,.62); font-family: var(--body); font-size: 1rem; }
  .signal-sources { display: grid; gap: .5rem; margin-top: 3rem; font-size: .64rem; color: rgba(216,255,224,.48); }
  .signal-sources p { color: var(--signal); }
  .signal-sources a { width: fit-content; color: rgba(216,255,224,.68); text-underline-offset: 3px; }
  @media (max-width: 820px) {
    .signal-hero { grid-template-columns: 28px 1fr; }
    .node-field { display: none; }
    .tally-section { grid-template-columns: 1fr; }
    .signal-method { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .signal-hero { grid-template-columns: 1fr; }
    .signal-rail { display: none; }
    .signal-copy h1 { font-size: clamp(3.2rem, 16vw, 5rem); }
    .tally-wall { grid-template-columns: repeat(10, 1fr); }
    .signal-gap { align-items: flex-start; flex-direction: column; }
  }
</style>
