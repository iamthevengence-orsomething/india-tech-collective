---
import Base from '../layouts/Base.astro';
const live = [
  ['Canonical site', 'https://www.indiatechcollective.org', 'https://www.indiatechcollective.org'],
  ['Source repository', 'github.com/iamthevengence-orsomething/india-tech-collective', 'https://github.com/iamthevengence-orsomething/india-tech-collective'],
  ['Record downloads', '/downloads/', '/downloads/README.txt'],
];
const gaps = ['IPFS release', 'Onion service', 'Kiwix ZIM'];
---
<Base
  title="Mirrors — India Tech Collective"
  description="Available copies, downloads, and explicit gaps in the India Tech Collective distribution plan."
  path="/mirrors/"
>
  <header class="mirror-head wrap">
    <p class="file-label">Distribution / mirrors</p>
    <h1>This site is a file.</h1>
    <p>Files are for copying. Only verified locations are listed as live.</p>
  </header>

  <section class="mirror-list wrap" aria-label="Verified locations">
    <p class="file-label">Available now</p>
    {live.map(([label, text, href]) => (
      <a href={href} class="mirror-row">
        <span>{label}</span>
        <strong>{text}</strong>
        <i>verified ↗</i>
      </a>
    ))}
  </section>

  <section class="mirror-list gaps wrap" aria-label="Distribution gaps">
    <p class="file-label">Not yet published</p>
    {gaps.map((label) => (
      <div class="mirror-row">
        <span>{label}</span>
        <strong>Address not in the file.</strong>
        <i>gap</i>
      </div>
    ))}
  </section>
</Base>

<style>
  .mirror-head { padding-block: clamp(4rem, 10vw, 8rem); }
  .mirror-head h1 { margin-top: 1rem; font-size: clamp(3.6rem, 9vw, 7rem); letter-spacing: -0.055em; line-height: 0.86; max-width: 8ch; }
  .mirror-head > p:last-child { margin-top: 1.5rem; color: var(--muted); }
  .mirror-list { margin-bottom: 4rem; }
  .mirror-list > .file-label { margin-bottom: 0.7rem; }
  .mirror-row { display: grid; grid-template-columns: 180px 1fr auto; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--line); color: inherit; text-decoration: none; }
  .mirror-row:last-child { border-bottom: 1px solid var(--line); }
  .mirror-row span, .mirror-row i { font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.05em; color: var(--muted); font-style: normal; }
  .mirror-row strong { font-family: var(--mono); font-size: 0.75rem; font-weight: 500; overflow-wrap: anywhere; }
  .mirror-row i { color: var(--stamp-violet); }
  .mirror-list a:hover strong { color: var(--stamp-violet); }
  .gaps .mirror-row { opacity: 0.66; }
  .gaps .mirror-row i { color: var(--seal-red); text-transform: uppercase; }
  @media (max-width: 680px) { .mirror-row { grid-template-columns: 1fr auto; } .mirror-row strong { grid-column: 1 / -1; grid-row: 2; } }
</style>
